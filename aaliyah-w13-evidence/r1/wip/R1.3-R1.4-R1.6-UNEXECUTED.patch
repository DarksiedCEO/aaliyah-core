+  git(["add", "-A"]);
+  git(["-c", "user.name=fixture", "-c", "user.email=fixture@invalid", "commit", "-q", "-m", "fixture"]);
+  for (const [rel, body] of Object.entries(untracked)) fs.writeFileSync(path.join(dir, rel), body);
